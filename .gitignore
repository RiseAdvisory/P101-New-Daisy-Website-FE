# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/
tmpclaude-*

# docs
# /docs/* rather than /docs: git will not descend into an excluded directory,
# so the negations below only take effect if the directory itself stays
# includable. Everything under docs/ is still ignored by default.
/docs/*
!/docs/daisy-authors/
!/docs/daisy-authors/**
# Channel alignment: store listing copy, screenshot asset locations, audit log.
# Deliberately tracked so the store source of truth is versioned. Credentials
# stay in ~/.daisy and must never be referenced here by id or account email.
!/docs/channel-alignment/
!/docs/channel-alignment/**
.superpowers/
trial-success-page.png
